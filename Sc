local function getCustomName(model)
	local nameLower = model.Name:lower();
	for _, key in ipairs(customNamesOrdered) do
		if nameLower:find(key) then
			return customNames[key].name;
		end
	end
	return model.Name;
end
local function isTargetModel(model)
	if not model then
		return false;
	end
	local modelName = tostring(model.Name):lower();
	local humanoid = model:FindFirstChildOfClass("Humanoid");
	local displayName = (humanoid and humanoid.DisplayName and tostring(humanoid.DisplayName):lower()) or "";
	for _, t in ipairs(targetNames) do
		if (modelName:find(t) or displayName:find(t)) then
			return true;
		end
	end
	return false;
end
local function getAdornee(model)
	local head = model:FindFirstChild("Head");
	if (head and head:IsA("BasePart")) then
		return head;
	end
	if (model.PrimaryPart and model.PrimaryPart:IsA("BasePart")) then
		return model.PrimaryPart;
	end
	for _, v in pairs(model:GetChildren()) do
		if v:IsA("BasePart") then
			return v;
		end
	end
	return nil;
end
local function createESPForModel(model)
	if espCache[model] then
		return;
	end
	local adornee = getAdornee(model);
	if not adornee then
		return;
	end
	local billboard = Instance.new("BillboardGui");
	billboard.Name = "ESP_Billboard";
	billboard.Adornee = adornee;
	billboard.Size = UDim2.new(0, 150, 0, 40);
	billboard.StudsOffset = Vector3.new(0, 2.5, 0);
	billboard.AlwaysOnTop = true;
	billboard.ResetOnSpawn = false;
	billboard.Enabled = settings.espEnabled;
	local textLabel = Instance.new("TextLabel", billboard);
	textLabel.Name = "ESPLabel";
	textLabel.Size = UDim2.new(1, 0, 1, 0);
	textLabel.BackgroundTransparency = 1;
	textLabel.TextColor3 = espColor;
	textLabel.TextStrokeTransparency = 0.5;
	textLabel.TextSize = 18;
	textLabel.Font = Enum.Font.SourceSansBold;
	local cachedName = getCustomName(model);
	textLabel.Text = cachedName;
	local selectionBox;
	if settings.showSelectionBox then
		local s = Instance.new("SelectionBox");
		s.Name = "ESPSelection";
		s.Adornee = adornee;
		s.LineThickness = 0;
		s.SurfaceTransparency = 1;
		s.Color3 = espColor;
		s.Visible = false;
		s.Parent = ESPFolder;
		selectionBox = s;
	end
	billboard.Parent = ESPFolder;
	local ancestryConn = model.AncestryChanged:Connect(function(_, parent)
		if (parent == nil) then
			removeESPForModel(model);
		end
	end);
	espCache[model] = {billboard=billboard,label=textLabel,selection=selectionBox,adornee=adornee,name=cachedName,lastDist=math.huge,ancestryConn=ancestryConn};
end
local function removeESPForModel(model)
	local data = espCache[model];
	if data then
		if data.ancestryConn then
			pcall(function()
				data.ancestryConn:Disconnect();
			end);
		end
		if (data.billboard and data.billboard.Parent) then
			data.billboard:Destroy();
		end
		if (data.selection and data.selection.Parent) then
			data.selection:Destroy();
		end
		espCache[model] = nil;
	end
end
local function updateAllESP()
	if not running then
		return;
	end
	for model, data in pairs(espCache) do
		if (not model or not model.Parent) then
			removeESPForModel(model);
		else
			local adornee = data.adornee;
			local label = data.label;
			local billboard = data.billboard;
			local selection = data.selection;
			local dist = math.huge;
			if (adornee and adornee:IsA("BasePart") and Camera) then
				dist = (Camera.CFrame.Position - adornee.Position).Magnitude;
			end
			local enabledNow = settings.espEnabled and (dist <= settings.maxDisplayDistance);
			if (billboard.Enabled ~= enabledNow) then
				billboard.Enabled = enabledNow;
			end
			if selection then
				selection.Visible = enabledNow;
			end
			if (math.abs(dist - (data.lastDist or math.huge)) >= 0.5) then
				label.Text = string.format("%s\n%.1fm", data.name or getCustomName(model), dist);
				data.lastDist = dist;
			end
			if (label.TextColor3 ~= espColor) then
				label.TextColor3 = espColor;
			end
			if selection then
				if (selection.Color3 ~= espColor) then
					selection.Color3 = espColor;
				end
			end
		end
	end
end
local function createAllESP()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and isTargetModel(obj)) then
			createESPForModel(obj);
		end
	end
end
