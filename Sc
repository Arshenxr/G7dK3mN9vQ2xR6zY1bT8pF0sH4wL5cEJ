local customNamesOrdered = {"legendarybison","legendaryblackbear","legendarycoyote","legendarydeerantler","legendarydeerbuck","legendarydirewolf","legendarywolf","legendarymooseantler","legendarymoosebull","direwolf"};
local espCache = {};
