local ICA_Toggle = AssistSection:AddToggle("InstantContextAction", {Title="Instant Context Action",Default=false});
getgenv().InstantContextAction = false;
local ICA_Hooked = false;
local function hookInstantContextAction()
	if ICA_Hooked then
		return;
	end
	ICA_Hooked = true;
	for _, v in pairs(getgc(true)) do
		if (type(v) == "function") then
			local info = debug.getinfo(v);
			if (info and (info.name == "ContextHoldFunc")) then
				local old;
				old = hookfunction(v, function(...)
					local args = {...};
					args[#args] = (getgenv().InstantContextAction and 0) or args[#args];
					return old(unpack(args));
				end);
			end
		end
	end
end
ICA_Toggle:OnChanged(function(v)
	getgenv().InstantContextAction = v;
	hookInstantContextAction();
end);
LocalPlayer.CharacterAdded:Connect(function()
	ICA_Hooked = false;
	if getgenv().InstantContextAction then
