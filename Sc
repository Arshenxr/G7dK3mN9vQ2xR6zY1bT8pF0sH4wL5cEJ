	end

	return OldNewIndex(...)
end), hookmetamethod(workspace.Horses, "__index", function(...)
	local Self, Key = ...

	if not checkcaller() and tostring(Self) == "CurrentStamina" and Key == "Value" and Settings.Character.InfiniteGallopStamina then
		return 400
	end

	return OldIndex(...)
end)

