local MyScript = Library:addPage("ESP Legendary", 12413838306)
local ESP_Section = MyScript:addSection("ESP Legendary Animals")

local ESP_Settings = {
	Enabled = true,
}

local espRunning = false

local function StartESP()
	if espRunning then return end
	espRunning = true
	ESP_Settings.Enabled = true

	task.spawn(function()
		local Players = game:GetService("Players")
		local RunService = game:GetService("RunService")
		local LocalPlayer = Players.LocalPlayer
		local Camera = workspace.CurrentCamera

		local Notification
		local success, module = pcall(function()
			return require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("NotificationModule"))
		end)
		if success and typeof(module) == "function" then
			Notification = module
		else
			warn("[ESP] ❌ Failed to load NotificationModule.")
		end

		local targetNames = {
			"legendarydirewolf",
			"legendarybison",
			"legendarygrizzlybear",
			"legendaryblackbear",
			"legendarywolf",
			"legendarymoosebull",
			"direwolf"
		}

		local defaultColor = Color3.fromRGB(255, 50, 50)
		local notifyColor = Color3.fromRGB(204, 102, 255)

		local settings = {
			espEnabled = true,
			showSelectionBox = true,
			maxDisplayDistance = 5000
		}

		local espCache = {}
		local connections = {}

		local customNames = {
			legendarydirewolf = { name = "Legendary Direwolf", color = notifyColor },
			legendarybison = { name = "Legendary Bison", color = notifyColor },
			legendarygrizzlybear = { name = "Legendary Grizzly Bear", color = notifyColor },
			legendaryblackbear = { name = "Legendary Black Bear", color = notifyColor },
			legendarywolf = { name = "Legendary Wolf", color = notifyColor },
			legendarymoosebull = { name = "Legendary Moose Bull", color = notifyColor },
			direwolf = { name = "Direwolf", color = notifyColor }
		}

		local customNamesOrdered = {
			"legendarydirewolf",
			"legendarybison",
			"legendarygrizzlybear",
			"legendaryblackbear",
			"legendarywolf",
			"legendarymoosebull",
			"direwolf"
		}

		local function getCustomNameAndColor(model)
			local nameLower = model.Name:lower()
			for _, key in ipairs(customNamesOrdered) do
				local value = customNames[key]
				if value and nameLower:find(key) then
					return value.name, value.color
				end
			end
			return model.Name, defaultColor
		end

		local function isTargetModel(model)
			if not model then return false end
			local modelName = tostring(model.Name):lower()
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local displayName = humanoid and humanoid.DisplayName and tostring(humanoid.DisplayName):lower() or ""
			for _, t in ipairs(targetNames) do
				if modelName:find(t) or displayName:find(t) then
					return true
				end
			end
			return false
		end

		local function getAdornee(model)
			local head = model:FindFirstChild("Head")
			if head and head:IsA("BasePart") then return head end
			if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then return model.PrimaryPart end
			for _, v in pairs(model:GetChildren()) do
				if v:IsA("BasePart") then return v end
			end
			return nil
		end

		local function createESPForModel(model)
			if espCache[model] then return end
			local adornee = getAdornee(model)
			if not adornee then return end

			local billboard = Instance.new("BillboardGui")
			billboard.Name = "ESP_Billboard"
			billboard.Adornee = adornee
			billboard.Size = UDim2.new(0, 150, 0, 40)
			billboard.StudsOffset = Vector3.new(0, 2.5, 0)
			billboard.AlwaysOnTop = true
			billboard.ResetOnSpawn = false
			billboard.Enabled = settings.espEnabled
			billboard.Parent = game:GetService("CoreGui")

			local textLabel = Instance.new("TextLabel")
			textLabel.Name = "ESPLabel"
			textLabel.Size = UDim2.new(1, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			local nameText, color = getCustomNameAndColor(model)
			textLabel.TextColor3 = color
			textLabel.TextStrokeTransparency = 0.5
			textLabel.TextSize = 18
			textLabel.Font = Enum.Font.SourceSansBold
			textLabel.Text = nameText
			textLabel.Parent = billboard
		end

		local function removeAllESP()
			for _, data in pairs(espCache) do
				if data.billboard then pcall(function() data.billboard:Destroy() end) end
				if data.selection then pcall(function() data.selection:Destroy() end) end
			end
			espCache = {}
		end

		local function updateAllESP()
			for model, data in pairs(espCache) do
				if not model or not model.Parent then
					if data.billboard then data.billboard:Destroy() end
					if data.selection then data.selection:Destroy() end
					espCache[model] = nil
				else
					local adornee = data.adornee
					local label = data.label
					local billboard = data.billboard
					local selection = data.selection
					local dist = math.huge
					if adornee and adornee:IsA("BasePart") and Camera then
						dist = (Camera.CFrame.Position - adornee.Position).Magnitude
					end
					if dist > settings.maxDisplayDistance or not settings.espEnabled then
						billboard.Enabled = false
						if selection then selection.Parent = nil end
					else
						billboard.Enabled = true
						if selection and not selection.Parent then selection.Parent = Camera end
					end
					local nameText, color = getCustomNameAndColor(model)
					label.Text = string.format("%s\n%.1fm", nameText, dist)
					label.TextColor3 = color
					if selection then selection.Color3 = color end
				end
			end
		end

		local function createAllESP()
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and isTargetModel(obj) then
					createESPForModel(obj)
				end
			end
		end

		createAllESP()

		table.insert(connections, workspace.DescendantAdded:Connect(function(obj)
			if not espRunning then return end
			if obj:IsA("Model") and isTargetModel(obj) then
				task.spawn(function()
					local adornee
					for i = 1, 20 do
						adornee = getAdornee(obj)
						if adornee then break end
						task.wait(0.05)
					end
					if adornee then
						createESPForModel(obj)
						local nameText, _ = getCustomNameAndColor(obj)
						if Notification then
							Notification(nameText .. " has spawned!", notifyColor)
						end
					end
				end)
			end
		end))

		table.insert(connections, RunService.RenderStepped:Connect(function()
			if espRunning then updateAllESP() end
		end))

		while ESP_Settings.Enabled do
			task.wait(1)
		end

		removeAllESP()
		for _, con in ipairs(connections) do
			if con and con.Disconnect then
				con:Disconnect()
			end
		end
		espRunning = false
		print("[ESP] Terminated.")
	end)
end


